{
  "name": "test-ssr",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:ssr": "node scripts/start-all.mjs",
    "serve:ssr:host": "node --import @angular-architects/native-federation/node-preload dist/host/server/server.mjs",
    "serve:ssr:example": "node dist/example/server/server.mjs",
    "serve:ssr:mfe1": "node --import @angular-architects/native-federation/node-preload dist/mfe1/server/server.mjs",
    "serve:ssr:mfe2": "node --import @angular-architects/native-federation/node-preload dist/mfe2/server/server.mjs",
    "start:dev": "node scripts/start-dev.mjs",
    "serve:dev:host": "ng serve host",
    "serve:dev:mfe1": "ng serve mfe1",
    "serve:dev:mfe2": "ng serve mfe2"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular-architects/native-federation": "~22.2.0",
    "@softarc/native-federation-orchestrator": "~4.7.0",
    "@angular/animations": "~22.2.0",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/platform-server": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@angular/ssr": "~22.2.0",
    "cors": "^2.8.5",
    "es-module-shims": "^1.5.12",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~22.2.0",
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "concurrently": "^9.2.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.19.0",
    "jsdom": "^28.0.0",
    "typescript": "~6.0.0",
    "vitest": "^4.0.8",
    "@softarc/native-federation": "~4.7.0"
  }
}
