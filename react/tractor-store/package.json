{
  "name": "tractor-store-react",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "cdn": "http-server ./public -p 3000 --cors -c-1 --silent",
    "start:all": "concurrently -n cdn,explore,decide,checkout,host \"pnpm cdn\" \"pnpm -F @tractor-store/explore start\" \"pnpm -F @tractor-store/decide start\" \"pnpm -F @tractor-store/checkout start\" \"pnpm -F @tractor-store/host start\"",
    "build": "pnpm -r --filter \"@tractor-store/*\" build",
    "test": "pnpm -r --filter \"@tractor-store/*\" test",
    "typecheck": "pnpm -r --filter \"@tractor-store/*\" typecheck"
  },
  "devDependencies": {
    "@softarc/native-federation": "~4.9.0",
    "@softarc/native-federation-esbuild": "~4.3.0",
    "@softarc/native-federation-orchestrator": "~4.9.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1",
    "jsdom": "^28.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.2",
    "vitest": "^4.0.8"
  }
}
